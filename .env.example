# ⚠ 봇 토큰 운영 지침
# 1) 토픽별 봇 토큰을 반드시 분리할 것.
#    하나를 공유하면 그 토큰이 새는 순간 두 채널이 동시에 장악된다.
#    (2026-09 기준 sto/realestate 가 TELEGRAM_BOT_TOKEN 하나를 공유 중 — 분리 권장)
# 2) 토큰이 로그·저장소에 노출된 적이 있으면 BotFather 에서 즉시 재발급할 것.
#    코드는 이제 로그 기록 시 토큰을 가리지만(bot/telegram.py mask_token),
#    이미 유출된 토큰은 재발급 외에 되돌릴 방법이 없다.

# ===========================================================
# 멀티 토픽 뉴스 텔레그램 봇  (.env.example)
#  - 한 프로세스가 여러 토픽(STO, 부동산)을 수집해 각자 다른 방으로 전송
#  - 실제 사용 시 이 파일을 .env 로 복사 후 값 채우기
# ===========================================================

# ── 공통: Naver Open API (모든 토픽 공유) ──
NAVER_CLIENT_ID=여기에_네이버_클라이언트_ID
NAVER_CLIENT_SECRET=여기에_네이버_시크릿

# ── 공통: 기본 텔레그램 봇 토큰 (토픽별 토큰 미지정 시 공용 사용) ──
TELEGRAM_BOT_TOKEN=여기에_봇_토큰

# ── (선택) 키워드 명령(/add,/del,/list) 슈퍼관리자 ──
# 기본적으로 '그 방(토픽 채널/그룹)의 관리자'면 명령을 쓸 수 있으므로 보통 비워두면 된다.
# 여기에 텔레그램 사용자 ID(쉼표로 여러 명)를 넣으면 DM 등 어디서든 쓸 수 있는 슈퍼관리자가 된다.
TELEGRAM_ADMIN_IDS=

# ── STO·조각투자 토픽 ──
# STO 뉴스를 받을 채팅방 ID (쉼표로 여러 개)
TELEGRAM_CHAT_IDS_STO=STO_채팅방ID
# (구버전 호환) TELEGRAM_CHAT_IDS_STO 가 없으면 이 값을 STO 채널로 사용
TELEGRAM_CHAT_IDS=STO_채팅방ID
# (선택) STO 전용 봇을 따로 쓸 때만 지정
TELEGRAM_BOT_TOKEN_STO=

# ── 부동산 토픽 (STO와 다른 텔레그램 방) ──
# 부동산 뉴스를 받을 채팅방 ID. 채우면 부동산 토픽 활성화
TELEGRAM_CHAT_IDS_REALESTATE=부동산_채팅방ID
# (선택) 부동산 전용 봇 (미지정 시 TELEGRAM_BOT_TOKEN 공용)
TELEGRAM_BOT_TOKEN_REALESTATE=

# (선택) 구동할 토픽 제한. 예: sto,realestate  (미지정 시 설정된 토픽 전부)
ENABLED_TOPICS=

# ── (선택) 통합 포스팅 앱에 같이 적기 (unified-posting-all) ──
# 이 봇은 보낸 뉴스를 남기지 않는다(대기 큐는 비우고, 캐시엔 URL·시각만 남는다).
# 아래 둘을 **다 채우면** 텔레그램으로 보낼 때 앱 서버에도 같이 적어서, 앱의 '뉴스' 탭에서
# 그 뉴스로 바로 블로그 글을 쓸 수 있다. 하나라도 비면 조용히 꺼진 채로 돈다(봇 단독 구동이 정상).
# 실패해도 텔레그램 전송은 그대로 간다 — 앱 서버가 죽어 있어도 뉴스는 계속 나간다.
#
# 도커 안에서 호스트의 18090 에 닿아야 하므로 localhost 가 아니라 host.docker.internal 이다.
UNIFIED_API_URL=
# 앱 서버(posting-api)의 NEWS_INGEST_TOKEN 과 **같은 값**이어야 한다
UNIFIED_INGEST_TOKEN=
